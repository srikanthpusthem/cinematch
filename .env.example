# Postgres connection string (local docker-compose default shown below).
# docker compose up -d, then: postgresql://cinematch:cinematch@localhost:5432/cinematch
# Quote the value if it contains "#" (e.g. in a password): DATABASE_URL="postgresql://..."
DATABASE_URL=

# TMDB API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# API key for the hosted LLM provider used for embeddings and re-ranking.
LLM_API_KEY=
